{
  "name": "agentctl-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check . && prettier --check \"**/*.md\"",
    "format": "biome check --write . && prettier --write \"**/*.md\"",
    "test": "turbo run test",
    "ci": "turbo run ci"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "turbo": "2.11.7",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
