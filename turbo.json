{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "rspack.config.*", "package.json", "tsconfig.json"],
      "outputs": ["dist/**"]
    },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "lint": {},
    "test": {
      "dependsOn": ["build"],
      "passThroughEnv": ["AGENTCTL_BIN", "DOCKER_HOST", "TESTCONTAINERS_*"]
    },
    "ci": { "dependsOn": ["build", "typecheck", "lint", "test"] }
  }
}
