{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "rspack.config.*", "package.json", "tsconfig.json"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["build"],
      "passThroughEnv": ["AGENTCTL_BIN", "DOCKER_HOST", "TESTCONTAINERS_*"]
    },
    "ci": {
      "dependsOn": [
        "build",
        "typecheck",
        "test",
        "//#lint:biome",
        "//#lint:prettier"
      ]
    },
    "//#lint:biome": {},
    "//#lint:prettier": {
      "inputs": ["**/*.md", ".prettierrc.json", ".prettierignore"]
    }
  }
}
