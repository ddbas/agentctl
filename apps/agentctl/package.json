{
  "name": "agentctl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "agentctl": "./dist/cli.cjs"
  },
  "dependencies": {
    "@agentctl/harness-claude": "workspace:*",
    "@agentctl/harness-pi": "workspace:*",
    "@agentctl/logging": "workspace:*",
    "@agentctl/state-fs": "workspace:*",
    "@agentctl/tmux": "workspace:*",
    "@agentctl/core": "workspace:*",
    "commander": "15.0.0",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@rspack/cli": "2.2.8",
    "@rspack/core": "2.2.8",
    "testcontainers": "12.2.0"
  },
  "scripts": {
    "build": "rspack build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm run build:test-image && vitest run",
    "lint:biome": "biome check .",
    "build:test-image": "docker build -q -t am-tmux-test:latest tests/",
    "test:e2e": "pnpm run build:test-image && vitest run tests/e2e"
  }
}
